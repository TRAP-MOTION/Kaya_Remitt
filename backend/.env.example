SECRET_KEY="secret-key"
DATABASE_URL="database-connection-string"
JWT_SECRET_KEY="jwt-secret-key" # Defaults to SECRET_KEY if not provided

# CORS — comma-separated list of allowed origins (production only).
# Leave unset or empty during local development to allow all origins.
# Example: ALLOWED_ORIGINS="https://app.example.com,https://www.example.com"
ALLOWED_ORIGINS=""

# PayChangu (hosted checkout)
PAYCHANGU_SECRET_KEY="paychangu-secret-key"
PAYCHANGU_CALLBACK_URL="https://your-frontend.example/payments/callback"
PAYCHANGU_RETURN_URL="https://your-frontend.example/payments/return"
PAYCHANGU_CURRENCY="MWK"
